generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

enum UserRole {
 EARNER
 CREATOR
}

enum MissionStatus {
 CREATED
 OPEN
 STARTED
 PAUSED
 COMPLETED
 CANCELLED
}

enum SubmissionStatus {
 PENDING
 APPROVED
 REJECTED
 PAID
}

model User {
 id String @id @default(uuid()) @map("id")
 address String @unique @map("address")
 email String? @unique @map("email")
 displayName String? @map("display_name")
 bio String? @map("bio")
 role UserRole @default(EARNER)

 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 // Relationships
 missions Mission[]
 submissions Submission[]
 missionDrafts MissionDraft[]

 @@map("users")
}

model Mission {
 id String @id @default(uuid()) @map("id")
 onChainId BigInt? @unique @map("on_chain_id")
 ownerAddress String @map("owner_address")
 title String @map("title")
 descriptionCid String @map("description_cid")
 metadataCid String @map("metadata_cid")
 metadata Json @map("metadata")
 rewardToken String @map("reward_token")
 rewardAmount String @map("reward_amount") // i128 stroops as string (lossless)
 maxParticipants Int @default(0) @map("max_participants")
 participantsCount Int @default(0) @map("participants_count")
 status MissionStatus @default(OPEN) @map("status")
 minAssetToken String? @map("min_asset_token")
 minAssetAmount String @default("0") @map("min_asset_amount") // i128 stroops as string
 escrowTxHash String? @map("escrow_tx_hash")
 aiSummary String @default("") @map("ai_summary")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 owner User @relation(fields: [ownerAddress], references: [address])
 submissions Submission[]

 @@index([ownerAddress])
 @@index([status, createdAt(sort: Desc)])
 @@index([onChainId])
 @@map("missions")
}

model MissionDraft {
 id String @id @default(uuid()) @map("id")
 ownerAddress String @map("owner_address")
 title String @map("title")
 data Json @map("data")
 publishedAt DateTime? @map("published_at")
 publishedMissionId String? @unique @map("published_mission_id")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 owner User @relation(fields: [ownerAddress], references: [address])

 @@index([ownerAddress, updatedAt])
 @@map("mission_drafts")
}

model Submission {
 id String @id @default(uuid()) @map("id")
 missionId String @map("mission_id")
 hunterAddress String @map("hunter_address")
 ipfsCid String @map("ipfs_cid")
 textPayload String? @map("text_payload")
 sentiment Float? @map("sentiment")
 status SubmissionStatus @default(PENDING) @map("status")
 stakeAmount String @default("0") @map("stake_amount") // i128 stroops as string
 stakeToken String? @map("stake_token")
 stakeTxHash String? @map("stake_tx_hash")
 submittedAtLedger BigInt? @map("submitted_at_ledger")
 rejectionReason String? @map("rejection_reason")
 txHash String? @unique @map("tx_hash")
 chainConfirmed Boolean @default(false) @map("chain_confirmed")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 mission Mission @relation(fields: [missionId], references: [id])
 hunter User @relation(fields: [hunterAddress], references: [address])

 @@unique([missionId, hunterAddress])
 @@index([hunterAddress])
 @@index([missionId])
 @@map("submissions")
}

model IndexerState {
 id Int @id @default(1) @map("id")
 lastLedger BigInt @map("last_ledger")
 lastCursor String? @map("last_cursor")
 updatedAt DateTime @updatedAt @map("updated_at")

 @@map("indexer_state")
}
